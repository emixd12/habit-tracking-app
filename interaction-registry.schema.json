{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.local/schemas/interaction-registry.schema.json",
  "title": "Cadence interaction registry",
  "description": "Canonical contract for implemented user interaction intents across Cadence product surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "product",
    "updated",
    "scope",
    "surfaces",
    "source_inventory",
    "interactions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.3.0" },
    "registry_id": { "const": "cadence.user-interactions" },
    "product": { "const": "Cadence" },
    "updated": { "type": "string", "format": "date" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "includes", "excludes"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "includes": { "$ref": "#/$defs/nonEmptyStrings" },
        "excludes": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "routes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["public", "authenticated", "conditional_development"]
          },
          "routes": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    },
    "source_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification", "interaction_marker_count", "interaction_ids"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["cataloged", "excluded"] },
          "interaction_marker_count": { "type": "integer", "minimum": 1 },
          "interaction_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/interactionId" },
            "uniqueItems": true
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/interaction" }
    }
  },
  "$defs": {
    "interactionId": {
      "type": "string",
      "pattern": "^INT-[A-Z]+-[0-9]{3}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "control"],
      "properties": {
        "kind": {
          "enum": [
            "activate",
            "change",
            "input",
            "submit",
            "upload",
            "keyboard",
            "gesture"
          ]
        },
        "control": { "type": "string", "minLength": 1 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "result"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 }
      }
    },
    "testCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "references", "notes"],
      "properties": {
        "level": { "enum": ["direct", "indirect", "manual", "none"] },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      }
    },
    "userGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "references"],
      "properties": {
        "audience": { "enum": ["user", "internal_qa"] },
        "references": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "effectCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "handler", "evidence"],
      "properties": {
        "effect": { "type": "string", "minLength": 1 },
        "handler": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "status"],
      "properties": {
        "applicability": { "enum": ["applicable", "not_applicable", "deferred"] },
        "status": { "enum": ["implemented", "planned", "not_applicable", "deferred"] },
        "implementation": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "follow_up": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "implemented" } } },
          "then": { "required": ["implementation", "evidence"] }
        },
        {
          "if": { "properties": { "status": { "const": "planned" } } },
          "then": { "required": ["follow_up"] }
        },
        {
          "if": { "properties": { "applicability": { "enum": ["not_applicable", "deferred"] } } },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "desktop", "marketing", "mobile"],
      "properties": {
        "web": { "$ref": "#/$defs/platform" },
        "desktop": { "$ref": "#/$defs/platform" },
        "marketing": { "$ref": "#/$defs/platform" },
        "mobile": { "$ref": "#/$defs/platform" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "surfaces",
        "routes",
        "journeys",
        "intent",
        "triggers",
        "availability",
        "success_result",
        "failure_result",
        "effects",
        "risk",
        "confirmation",
        "implementation",
        "user_guidance",
        "test_coverage",
        "platforms"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/interactionId" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["implemented", "planned", "deferred"] },
        "surfaces": { "$ref": "#/$defs/nonEmptyStrings" },
        "routes": { "$ref": "#/$defs/nonEmptyStrings" },
        "journeys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^J[0-9]{2}$" },
          "uniqueItems": true
        },
        "intent": { "type": "string", "minLength": 1 },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/trigger" }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        },
        "availability": { "type": "string", "minLength": 1 },
        "success_result": { "type": "string", "minLength": 1 },
        "failure_result": { "type": "string" },
        "effects": { "$ref": "#/$defs/nonEmptyStrings" },
        "effect_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effectCheck" }
        },
        "risk": { "enum": ["low", "moderate", "high", "destructive"] },
        "confirmation": {
          "enum": [
            "none",
            "browser_prompt",
            "acknowledgement",
            "typed",
            "acknowledgement_and_typed"
          ]
        },
        "implementation": { "$ref": "#/$defs/nonEmptyStrings" },
        "user_guidance": { "$ref": "#/$defs/userGuidance" },
        "test_coverage": { "$ref": "#/$defs/testCoverage" },
        "platforms": { "$ref": "#/$defs/platforms" }
      }
    }
  }
}
