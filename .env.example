# Supabase runtime
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public API key for new Supabase projects. Legacy anon keys are still supported below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Supabase CLI / hosted project reference
# Prefer `npm run supabase -- login` and `npm run supabase -- link` for CLI auth.
SUPABASE_PROJECT_REF=

# Auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sequenzy runtime and CLI
# SEQUENZY_API_KEY is server-only. Never expose it with NEXT_PUBLIC_.
SEQUENZY_API_KEY=
SEQUENZY_REMINDER_TEMPLATE_SLUG=
SEQUENZY_API_URL=https://api.sequenzy.com
SEQUENZY_APP_URL=https://sequenzy.com

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Internal cron/process protection
REMINDER_PROCESS_SECRET=
