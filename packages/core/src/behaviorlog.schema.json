        "recurrence": { "type": "object" },
        "anchor_local_date": { "$ref": "#/$defs/LocalDate" },
        "time_entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ConfigurationTimeEntry" } },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "allOf": [{
        "if": { "properties": { "recurrence_profile": { "const": "behaviorlog.calendar_simple.v1" } } },
        "then": { "properties": { "recurrence": { "$ref": "#/$defs/CalendarSimpleRecurrence" } } }
      }]
    },
