    "BehaviorConfigurationEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "event_id", "behavior_id", "event_kind", "previous", "next", "changed_fields", "recorded_at_utc", "effective_at_utc", "effective_local_date", "timezone", "source"],
      "properties": {
        "record_type": { "const": "behavior_configuration_event" },
        "event_id": { "type": "string", "minLength": 1 },
        "behavior_id": { "type": "string", "minLength": 1 },
        "event_kind": { "enum": ["baseline", "revision"] },
        "previous": { "anyOf": [{ "$ref": "#/$defs/ConfigurationSnapshot" }, { "type": "null" }] },
        "next": { "$ref": "#/$defs/ConfigurationSnapshot" },
        "changed_fields": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["category", "schedules", "intervention_rules", "active", "timezone"] }
        },
        "recorded_at_utc": { "$ref": "#/$defs/Timestamp" },
        "effective_at_utc": { "$ref": "#/$defs/Timestamp" },
        "effective_local_date": { "$ref": "#/$defs/LocalDate" },
        "timezone": { "$ref": "#/$defs/Timezone" },
        "source": { "$ref": "#/$defs/Source" },
        "reason_code": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "event_kind": { "const": "baseline" } } },
          "then": { "properties": { "previous": { "type": "null" }, "changed_fields": { "minItems": 5, "maxItems": 5 } } },
          "else": { "properties": { "previous": { "$ref": "#/$defs/ConfigurationSnapshot" } } }
        },
        {
          "if": { "properties": { "changed_fields": { "maxItems": 0 } } },
          "then": { "properties": { "source": { "required": ["transformation_notes"], "properties": { "transformation_notes": { "type": "string", "minLength": 1 } } } } }
        }
      ]
    },
    "ExchangeDeclaration": {
