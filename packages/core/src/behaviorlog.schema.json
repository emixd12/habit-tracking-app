    "CalendarSimpleRecurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["daily", "every_n_days", "weekly_on_weekdays", "every_n_weeks_on_weekdays", "monthly_on_day"] },
        "interval": { "type": "integer", "minimum": 1 },
        "weekdays": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }
        },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "fallback": { "const": "last_day_of_month" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["every_n_days", "every_n_weeks_on_weekdays"] } } },
          "then": { "required": ["interval"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["weekly_on_weekdays", "every_n_weeks_on_weekdays"] } } },
          "then": { "required": ["weekdays"], "not": { "anyOf": [{ "required": ["day"] }, { "required": ["fallback"] }] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["daily", "every_n_days"] } } },
          "then": { "not": { "anyOf": [{ "required": ["weekdays"] }, { "required": ["day"] }, { "required": ["fallback"] }] } }
        },
        {
          "if": { "properties": { "type": { "const": "monthly_on_day" } } },
          "then": { "required": ["day"], "not": { "required": ["weekdays"] } }
        }
      ]
    },
    "ConfigurationTimeEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["local_time", "window_start_local", "window_end_local"],
      "properties": {
        "local_time": { "$ref": "#/$defs/LocalTime" },
        "window_start_local": { "anyOf": [{ "$ref": "#/$defs/LocalTime" }, { "type": "null" }] },
        "window_end_local": { "anyOf": [{ "$ref": "#/$defs/LocalTime" }, { "type": "null" }] },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "oneOf": [
        { "properties": { "window_start_local": { "type": "null" }, "window_end_local": { "type": "null" } } },
        { "properties": { "window_start_local": { "$ref": "#/$defs/LocalTime" }, "window_end_local": { "$ref": "#/$defs/LocalTime" } } }
      ]
