---
import BrandMarks from "../components/BrandMarks.astro";
import RouteJsonLd from "../components/RouteJsonLd.astro";
import { getCanonicalUrl, getRouteById, type MarketingRoute } from "../data/routes";
import { primaryCtas, siteConfig } from "../data/site";
import "../styles/global.css";

type Props = {
  route: MarketingRoute;
};

const { route } = Astro.props;
const canonicalUrl = getCanonicalUrl(route.path);
const markdownUrl = getCanonicalUrl(route.markdownPath);
const pageTitle = route.path === "/" ? route.title : `${route.title} | Cadence`;
const ogImageUrl = getCanonicalUrl("/brand/cadence-logo.png");
const headerRoutes = [
  getRouteById("cadence"),
  getRouteById("standard"),
];
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={route.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/brand/cadence-logo.png" />
    <link rel="alternate" type="text/markdown" href={markdownUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={route.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={route.type === "documentation" ? "article" : "website"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={route.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <RouteJsonLd route={route} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="brand-lockup" href="/" aria-label="Cadence home">
            <BrandMarks />
          </a>
          <div class="site-header__nav-area">
            <nav class="site-nav" aria-label="Marketing">
              {
                headerRoutes.map((item) => (
                  <a
                    href={item.path}
                    aria-current={item.path === route.path ? "page" : undefined}
                  >
                    {item.navLabel}
                  </a>
                ))
              }
            </nav>
            <a class="site-header__login" href={primaryCtas.logIn.href}>
              {primaryCtas.logIn.label}
            </a>
          </div>
        </div>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <p>
            Cadence is the tracker. BehaviorLog is the open standard behind portable records.
          </p>
          <div class="cta-row" aria-label="Project links">
            <a class="inline-link" href="/cadence">Cadence</a>
            <a class="inline-link" href="/standard">BehaviorLog</a>
            <a class="inline-link" href="/about">About</a>
            <a class="inline-link" href={primaryCtas.viewGithub.href}>GitHub</a>
            <a class="inline-link" href="/llms.txt">llms.txt</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
