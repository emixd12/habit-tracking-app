---
import ProductCapture from "../components/ProductCapture.astro";
import { getRouteById } from "../data/routes";
import { primaryCtas } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const route = getRouteById("standard");
---

<BaseLayout route={route}>
  <section class="page-section hero" aria-labelledby="standard-title">
    <div class="page-section__inner">
      <div class="stack">
        <h1 id="standard-title">BehaviorLog is the open record format behind Cadence exports.</h1>
        <p>
          BehaviorLog defines a compact bundle for recurring behavior data: behaviors,
          schedules, occurrences, status events, notes, provenance, and hashes. Cadence
          uses it as the portability layer for export, import, examples, and agent
          inspection.
        </p>
        <div class="cta-row">
          <a class="button button--primary" href={primaryCtas.viewStandardRepository.href}>
            {primaryCtas.viewStandardRepository.label}
          </a>
          <a class="button" href={primaryCtas.downloadExample.href}>
            {primaryCtas.downloadExample.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="standard-files-title">
    <div class="page-section__inner section-grid">
      <div class="stack">
        <h2 id="standard-files-title">The bundle is a folder with an audit trail.</h2>
        <p>
          <code>manifest.json</code> names every file and hash. JSONL files carry
          records. Optional CSV views exist for migration, but they do not replace the
          authoritative event stream.
        </p>
      </div>
      <ProductCapture variant="bundle" />
    </div>
  </section>

  <section class="page-section" aria-labelledby="standard-contract-title">
    <div class="page-section__inner">
      <div class="split-grid">
        <div class="ledger-row">
          <h2 id="standard-contract-title">Core contract</h2>
          <ul class="text-list">
            <li>Statuses are unresolved, completed, and not_completed.</li>
            <li>Unresolved is not a failure state.</li>
            <li>Local dates and IANA timezones travel with occurrences.</li>
            <li>Custom producer fields stay inside extensions.</li>
          </ul>
        </div>
        <div class="ledger-row">
          <h2>Cadence relationship</h2>
          <p>
            Cadence is the tracker people use. BehaviorLog is the standard Cadence
            writes and reads so behavior history can leave the app without losing
            status events, local dates, or provenance.
          </p>
          <a class="button" href="/docs">Open Cadence docs</a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="standard-agent-title">
    <div class="page-section__inner section-grid">
      <div class="stack">
        <h2 id="standard-agent-title">Rules for readers and agents</h2>
        <ul class="text-list">
          <li>Use <code>data/status_events.jsonl</code> as the history authority.</li>
          <li>Treat <code>occurrences.jsonl</code> current_status as a quick-load snapshot.</li>
          <li>Keep unresolved distinct from Not Completed.</li>
          <li>Preserve namespaced extension fields when round-tripping a bundle.</li>
        </ul>
      </div>
      <div class="ledger-panel">
        <div class="ledger-panel__header">
          <span class="quiet-label">Base layer</span>
        </div>
        <div class="ledger-row">
          <h3>Open format</h3>
          <p>BehaviorLog can be implemented by tools other than Cadence.</p>
        </div>
        <div class="ledger-row">
          <h3>Cadence producer</h3>
          <p>Cadence uses the format to produce practical, inspectable exports from real app state.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
