---
import HeroVisual from "../components/HeroVisual.astro";
import HowItWorks from "../components/HowItWorks.astro";
import { getRouteById } from "../data/routes";
import { primaryCtas, siteConfig } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const route = getRouteById("home");
---

<BaseLayout route={route}>
  <section class="page-section hero hero--home" aria-labelledby="home-title">
    <div class="page-section__inner">
      <div class="hero-copy">
        <h1 id="home-title">Decide your days. Own every record.</h1>
        <p>
          An open-source tracker for recurring behaviors. Every scheduled item waits for your call — nothing is ever marked missed for you — and your whole history exports as plain files any tool can read.
        </p>
        <div class="cta-row" aria-label="Primary actions">
          <a class="text-action text-action--primary" href={primaryCtas.tryCadence.href}>Try Cadence →</a>
          <a class="text-action text-action--secondary" href={siteConfig.githubUrl}>View on GitHub</a>
        </div>
      </div>
      <div class="hero-visual-col">
        <HeroVisual />
      </div>
    </div>
  </section>

  <section class="page-section ledger-section" aria-labelledby="ledger-title">
    <div class="page-section__inner">
      <h2 id="ledger-title" class="sr-only">What Cadence does</h2>
      <div class="feature-ledger" data-reveal>
        <article>
          <h3>Behaviors on your schedule</h3>
          <p>Daily, every N days, weekly, or monthly — at exact times or ranges like Morning and Evening. Reminders optional.</p>
          <div class="chip-row">
            <span>Daily</span><span>Weekly</span><span class="chip--nowrap">Morning · 6:00–12:00</span>
          </div>
        </article>
        <article>
          <h3>You make every call</h3>
          <p>Completed, Not Completed, or left Unresolved until you settle it. Silence is never turned into failure.</p>
          <div class="status-row">
            <span>✓ <u>Completed</u></span>
            <span class="status--nc">✕ <u>Not Completed</u></span>
            <span class="status--muted">Unresolved</span>
          </div>
        </article>
        <article>
          <h3>Plain files, five formats</h3>
          <p>Export the full history anytime — readable in a text editor, a spreadsheet, or by any AI tool you point at it.</p>
          <div class="chip-row">
            <span>JSONL</span><span>CSV</span><span>Markdown</span><span class="chip--primary">BehaviorLog</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <HowItWorks />

  <section class="page-section page-section--ink" aria-labelledby="behaviorlog-title">
    <div class="page-section__inner record-grid" data-reveal>
      <div class="stack">
        <span class="quiet-label quiet-label--ink">The record layer</span>
        <h2 id="behaviorlog-title">Every export opens without Cadence.</h2>
        <p>A BehaviorLog bundle is plain JSONL files with a manifest and checksums. If this app disappeared tomorrow, your record would still open.</p>
        <div class="cta-row">
          <a class="text-action text-action--ink" href="/standard">Read the BehaviorLog spec →</a>
          <a class="text-action text-action--ink-muted" href={primaryCtas.downloadExample.href}>Download the example bundle</a>
        </div>
      </div>
      <div class="bundle-tree" aria-label="Files in the Cadence example BehaviorLog bundle">
        <div class="bundle-tree__header">
          <span>cadence-demo.behaviorlog.zip</span>
          <span class="bundle-tree__meta">8 files · SHA-256 verified</span>
        </div>
        <pre><span>├── manifest.json</span>
<span>├── schema.json</span>
<span>├── README.md</span>
<span>├── AGENTS.md</span>
<span>└── data/</span>
<span>    ├── behaviors.jsonl</span>
<span>    ├── schedules.jsonl</span>
<span>    ├── occurrences.jsonl</span>
<span class="bundle-tree__authority">    └── status_events.jsonl   ← history authority</span></pre>
      </div>
    </div>
  </section>

  <section class="page-section closing-section" aria-labelledby="closing-title">
    <div class="page-section__inner closing-cta" data-reveal>
      <h2 id="closing-title">Start your record.</h2>
      <p>Create a behavior, decide your first occurrence, and export whenever you like.</p>
      <div class="cta-row">
        <a class="text-action text-action--primary" href={primaryCtas.tryCadence.href}>Try Cadence →</a>
        <a class="text-action text-action--secondary" href={primaryCtas.viewGithub.href}>View on GitHub</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      if (
        window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
        !("IntersectionObserver" in window)
      ) {
        return;
      }

      document.documentElement.classList.add("js-reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.15 },
      );

      document.querySelectorAll("[data-reveal]").forEach((element) => observer.observe(element));
    })();
  </script>
</BaseLayout>

<style>
  /* Approved landing revisions: 2.5rem headline, split hero with the live
     horse/product group, and app-native underlined text actions (no buttons,
     no rounded corners). */

  .hero--home h1 {
    font-size: 2.5rem;
    max-width: 16ch;
  }

  /* 110.4% ≈ 1 / 0.906: the timeline card ends at 90.6% of the hg canvas
     (left 34.6% + width 56%), so this overhang puts its right edge exactly
     on the container's right edge — matching the text's left inset.
     Desktop grows to 125% with a -13.25% pull (13.25 = 90.6 × 1.25 − 100)
     so the group scales up-left while that right edge stays pinned. */
  .hero-visual-col {
    min-width: 0;
    width: 125%;
    margin-left: -13.25%;
  }

  .cta-row { gap: 2rem; }

  .text-action {
    font-size: 1.1rem;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    white-space: nowrap;
    transition: color 160ms ease-out, text-shadow 160ms ease-out;
  }
  .text-action:hover { text-shadow: 0.02em 0 currentColor; }
  .text-action--primary { color: var(--primary); }
  .text-action--secondary { color: var(--muted-readable); }
  .text-action--secondary:hover { color: var(--foreground); }
  .text-action--ink { color: var(--ink-text); font-size: 0.95rem; }
  .text-action--ink-muted { color: var(--ink-muted); font-size: 0.95rem; }
  .text-action--ink-muted:hover { color: var(--ink-text); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ledger-section .page-section__inner { padding-block: 4.5rem; }

  .feature-ledger {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }
  .feature-ledger article {
    display: grid;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--background);
    align-content: start;
  }
  .feature-ledger h3 { font-size: 1.2rem; line-height: 1.25; }
  .feature-ledger p { font-size: 0.95rem; }

  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip-row > span {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    padding: 0.3rem 0.6rem;
    color: var(--muted-readable);
    font-size: 0.72rem;
  }
  .chip-row > .chip--primary {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--foreground);
  }
  .chip--nowrap { white-space: nowrap; }

  .status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: baseline;
    font-size: 0.85rem;
  }
  .status-row > span { white-space: nowrap; }
  .status-row u { text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .status--nc { color: var(--accent); }
  .status--muted { color: var(--muted-readable); }

  .record-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (width < 820px) {
    .hero-visual-col {
      width: 110.4%;
      margin-left: 0;
    }

    .feature-ledger { grid-template-columns: 1fr; }
    .record-grid { grid-template-columns: 1fr; }
  }
</style>
