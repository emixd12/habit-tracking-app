---
import HeroVisual from "../components/HeroVisual.astro";
import ProductCapture from "../components/ProductCapture.astro";
import { getRouteById } from "../data/routes";
import { primaryCtas } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const route = getRouteById("home");
---

<BaseLayout route={route}>
  <section class="page-section hero hero--home" aria-labelledby="home-title">
    <div class="page-section__inner">
      <div class="hero-copy">
        <h1 id="home-title">Track recurring behaviors without locking up the record.</h1>
        <p>
          Cadence is an open tracker for recurring life patterns. You decide each
          scheduled occurrence as Completed or Not Completed, leave unclear days
          Unresolved, and export the full history as a BehaviorLog bundle.
        </p>
        <div class="cta-row" aria-label="Primary actions">
          <a class="button button--primary" href={primaryCtas.tryCadence.href}>
            {primaryCtas.tryCadence.label}
          </a>
          <a class="button" href={primaryCtas.readStandard.href}>
            {primaryCtas.readStandard.label}
          </a>
          <a class="button" href={primaryCtas.downloadExample.href}>
            {primaryCtas.downloadExample.label}
          </a>
          <a class="button" href={primaryCtas.viewGithub.href}>
            {primaryCtas.viewGithub.label}
          </a>
        </div>
      </div>
      <HeroVisual />
    </div>
  </section>

  <section class="page-section" aria-labelledby="standard-first-title">
    <div class="page-section__inner section-grid">
      <div class="stack">
        <h2 id="standard-first-title">BehaviorLog is the file format behind Cadence exports.</h2>
        <p>
          BehaviorLog stores behaviors, schedules, occurrences, status changes,
          notes, and provenance in plain files. Cadence writes and reads the
          format so a history can be checked, migrated, or archived outside the app.
        </p>
      </div>
      <div class="ledger-panel">
        <div class="ledger-panel__header">
          <span class="quiet-label">BehaviorLog record contract</span>
        </div>
        <div class="ledger-row">
          <h3>JSONL is authoritative.</h3>
          <p>CSV views are useful for migration, but JSONL records carry the source history.</p>
        </div>
        <div class="ledger-row">
          <h3>Status history is explicit.</h3>
          <p>
            Use <code>status_events.jsonl</code> for analysis. Do not treat silence
            as intent.
          </p>
        </div>
        <div class="ledger-row">
          <h3>Extensions stay namespaced.</h3>
          <p>Cadence-specific data stays under <code>extensions.app.cadence</code>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="cadence-demo-title">
    <div class="page-section__inner section-grid">
      <div class="stack">
        <h2 id="cadence-demo-title">Cadence is the tracker people use day to day.</h2>
        <p>
          Create behaviors, generate scheduled occurrences, mark Completed or Not
          Completed, add notes, get reminders, review basic analytics, and export.
          If you do not decide, the occurrence stays Unresolved.
        </p>
        <div class="cta-row">
          <a class="button button--primary" href="/cadence">Open Cadence overview</a>
          <a class="button" href="/standard">Read BehaviorLog page</a>
        </div>
      </div>
      <ProductCapture variant="bundle" />
    </div>
  </section>
</BaseLayout>
