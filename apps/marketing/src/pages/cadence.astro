---
import ProductCapture from "../components/ProductCapture.astro";
import { getRouteById } from "../data/routes";
import { primaryCtas } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const route = getRouteById("cadence");
---

<BaseLayout route={route}>
  <section class="page-section hero" aria-labelledby="cadence-title">
    <div class="page-section__inner">
      <div class="stack">
        <h1 id="cadence-title">Cadence is the reference tracker.</h1>
        <p>
          Cadence is a sparse, open-source web app for one account at a time. It turns
          recurring behaviors into scheduled occurrences, then records only what the
          user explicitly marks.
        </p>
        <div class="cta-row">
          <a class="button button--primary" href={primaryCtas.tryCadence.href}>
            {primaryCtas.tryCadence.label}
          </a>
          <a class="button" href={primaryCtas.viewGithub.href}>
            {primaryCtas.viewGithub.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="cadence-capture-title">
    <div class="page-section__inner section-grid">
      <div class="stack">
        <h2 id="cadence-capture-title">The product stays small.</h2>
        <ul class="text-list">
          <li>Timeline first.</li>
          <li>Manual Completed and Not Completed decisions.</li>
          <li>Unresolved prior days grouped under Needs decision.</li>
          <li>Notes attached to occurrences.</li>
          <li>JSONL, CSV, full JSON, Markdown, and BehaviorLog exports.</li>
        </ul>
      </div>
      <ProductCapture variant="timeline" />
    </div>
  </section>

  <section class="page-section" aria-labelledby="cadence-boundaries-title">
    <div class="page-section__inner">
      <div class="ledger-panel">
        <div class="ledger-panel__header">
          <h2 id="cadence-boundaries-title">Scope boundaries</h2>
        </div>
        <div class="ledger-row">
          <h3>Single-player accounts</h3>
          <p>No collaboration, shared workspaces, public profiles, or admin-heavy SaaS workflows.</p>
        </div>
        <div class="ledger-row">
          <h3>No gamification</h3>
          <p>No streak rewards, social pressure, coaching copy, or automatic missed status.</p>
        </div>
        <div class="ledger-row">
          <h3>Portability first</h3>
          <p>Exports and account deletion are part of the trust posture, not an advanced feature.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

