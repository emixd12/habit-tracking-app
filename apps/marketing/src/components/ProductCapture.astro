---
type Props = { variant: "definition" | "adherence" };
const { variant } = Astro.props;
---

{variant === "definition" ? (
  <figure class="product-capture product-capture--definition" aria-label="Tracked Behavior definition change from 45 Minutes of Exercise, Walks and Runs, to 1 Hour of Exercise, Resistance Training">
    <div class="definition-shot">
      <dl aria-label="Earlier Behavior definition">
        <div><dt>Title</dt><dd>45 Minutes of Exercise</dd></div>
        <div><dt>Description</dt><dd>Walks and Runs</dd></div>
      </dl>
      <span class="definition-shot__arrow" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
      </span>
      <dl aria-label="Revised Behavior definition">
        <div><dt>Title</dt><dd>1 Hour of Exercise</dd></div>
        <div><dt>Description</dt><dd>Resistance Training</dd></div>
      </dl>
    </div>
  </figure>
) : (
  <figure class="product-capture" aria-label="Overall adherence across 30 days">
    <div class="adherence-shot">
      <div class="adherence-shot__summary"><span>Overall adherence</span><strong>80%</strong><small>24 Completed · 6 Not Completed · 3 Unresolved</small></div>
      <div class="ranges"><span>7 days</span><b>30 days</b><span>90 days</span></div>
      <div class="heatmap">{Array.from({length:30},(_,i)=><span class:list={["cell",[4,10,17,25].includes(i)&&"cell--not",[7,21,28].includes(i)&&"cell--unresolved"]}></span>)}</div>
      <div class="legend"><span><i class="completed"></i>Completed</span><span><i class="not"></i>Not Completed</span><span><i class="unresolved"></i>Unresolved</span></div>
    </div>
  </figure>
)}

<style>
  .product-capture{min-width:0;border:1px solid var(--line);background:var(--background)}
  .product-capture.product-capture--definition{border:0;border-radius:0;background:transparent}.definition-shot{display:grid;grid-template-columns:max-content;justify-content:center;gap:1rem;padding:1rem}.definition-shot dl{display:grid;gap:.75rem;margin:0;font-size:.9rem}.definition-shot dl>div{display:grid;grid-template-columns:4.75rem max-content;gap:3rem;align-items:baseline}.definition-shot dt{color:var(--foreground)}.definition-shot dd{margin:0;color:var(--muted-readable);line-height:1.45}.definition-shot__arrow{display:grid;place-items:center;justify-self:center;color:var(--primary);rotate:90deg}.definition-shot__arrow svg{display:block}
  .adherence-shot{display:grid;gap:1rem;padding:1.25rem}.adherence-shot__summary{display:grid;grid-template-columns:auto 1fr;gap:.2rem 1rem;align-items:baseline}.adherence-shot__summary>span{grid-column:1/-1;color:var(--muted-readable)}.adherence-shot__summary strong{font-size:2.5rem;font-weight:400}.adherence-shot__summary small{color:var(--muted-readable)}.ranges{display:flex;gap:1.25rem;font-size:.78rem}.ranges>*{font-weight:400;text-decoration:underline;text-underline-offset:4px}.heatmap{display:grid;grid-template-columns:repeat(10,1fr);gap:4px}.cell{aspect-ratio:1;background:var(--primary)}.cell--not{background:var(--accent)}.cell--unresolved{border:1px solid var(--line);background:var(--surface)}.legend{display:flex;flex-wrap:wrap;gap:1rem;color:var(--muted-readable);font-size:.75rem}.legend span{display:flex;align-items:center;gap:.4rem}.legend i{width:.75rem;height:.75rem;background:var(--primary)}.legend .not{background:var(--accent)}.legend .unresolved{border:1px solid var(--line);background:var(--surface)}
  @media(width < 560px){.adherence-shot__summary{grid-template-columns:1fr}}@media(width < 360px){.definition-shot dl>div{gap:1.5rem}}
</style>
