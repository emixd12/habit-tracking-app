---
type Props = {
  showText?: boolean;
};

const { showText = true } = Astro.props;
---

<span class="brand-lockup__marks" aria-hidden="true">
  <img
    class="brand-lockup__cadence"
    src="/brand/cadence-logo.png"
    width="32"
    height="32"
    alt=""
    loading="eager"
    decoding="async"
  />
</span>
{
  showText && (
    <span class="brand-lockup__text">
      <span class="brand-lockup__name">Cadence</span>
    </span>
  )
}
