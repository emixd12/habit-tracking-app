---
type Props = {
  showText?: boolean;
};

const { showText = true } = Astro.props;
---

<span class="brand-lockup__marks" aria-hidden="true">
  <img
    class="brand-lockup__cadence"
    src="/brand/cadence-logo.png"
    width="32"
    height="32"
    alt=""
    loading="eager"
    decoding="async"
  />
  <svg
    class="brand-lockup__behaviorlog"
    viewBox="0 0 32 32"
    role="img"
    focusable="false"
    aria-label="BehaviorLog mark"
  >
    <rect x="6" y="6" width="20" height="20" fill="var(--background)"></rect>
    <path d="M6 12H26M6 18H26M12 6V26M18 6V26" stroke="var(--line)" stroke-width="1"></path>
    <rect x="12" y="12" width="6" height="6" fill="var(--primary-soft)"></rect>
    <rect x="18" y="18" width="8" height="8" fill="var(--surface-strong)"></rect>
  </svg>
</span>
{
  showText && (
    <span class="brand-lockup__text">
      <span class="brand-lockup__name">BehaviorLog</span>
      <span class="brand-lockup__subname">with Cadence</span>
    </span>
  )
}

