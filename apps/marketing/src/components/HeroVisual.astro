---
import ProductCapture from "./ProductCapture.astro";
---

<div class="hero-media" aria-hidden="true">
  <img
    class="hero-media__illustration"
    src="/brand/cadence-horse-trajectory.png"
    width="1311"
    height="1200"
    alt=""
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="hero-device">
    <img
      class="hero-device__frame"
      src="/brand/macbook-pro-frame.png"
      width="1224"
      height="1285"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-device__screen">
      <div class="hero-device__screen-inner">
        <ProductCapture variant="timeline" />
      </div>
    </div>
  </div>
</div>
