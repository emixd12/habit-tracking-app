{
  "name": "cadence-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "marketing:dev": "npm --workspace apps/marketing run dev",
    "marketing:build": "npm --workspace apps/marketing run build",
    "marketing:check": "npm --workspace apps/marketing run check",
    "marketing:preview": "npm --workspace apps/marketing run preview",
    "design-system:check": "node scripts/check-design-system.mjs",
    "agents:check": "node scripts/check-agents.mjs",
    "interactions:check": "node scripts/check-interactions.mjs",
    "resolvers:check": "node scripts/check-resolvers.mjs",
    "perf:routes": "node scripts/performance-route-harness.mjs",
    "smoke:rls": "node scripts/supabase-rls-smoke.mjs",
    "smoke:schedule-integrity:local": "psql postgresql://postgres:postgres@127.0.0.1:55322/postgres -v ON_ERROR_STOP=1 -f tests/sql/ticket-060-schedule-integrity-smoke.sql",
    "test-login:cleanup": "node scripts/supabase-test-login-cleanup.mjs",
    "agentmail": "node scripts/agentmail-cli.mjs",
    "agentmail:version": "node scripts/agentmail-cli.mjs --version",
    "supabase": "supabase",
    "sequenzy": "sequenzy"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@sequenzy/cli": "^0.0.34",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "agentmail-cli": "^0.7.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "supabase": "^2.105.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
